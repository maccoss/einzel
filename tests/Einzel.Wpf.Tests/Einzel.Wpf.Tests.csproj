<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Windows only, and it is the one test project here that is. Architecture invariant 1
    says nothing below the shell may reference it and everything above must build and run
    on Linux; the shell itself is the exception the invariant exists to draw a line
    around. `ShellBoundaryTests` in Einzel.Cli.Tests is what enforces the no-reference
    rule, and that runs everywhere.

    On a non-Windows host this builds as an ordinary net10.0 assembly with no sources and
    no test adapter, so `dotnet test` over the solution walks past it rather than failing.
    Compiling nothing is deliberate: a stub that asserted something would be asserting it
    about a shell that is not there.
  -->
  <PropertyGroup>
    <TargetFramework Condition="$([MSBuild]::IsOSPlatform('Windows'))">net10.0-windows</TargetFramework>
    <UseWPF Condition="$([MSBuild]::IsOSPlatform('Windows'))">true</UseWPF>

    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!--
      Same reason as the shell itself: WPF cannot run in globalization-invariant mode, and
      a test host that loads it inherits the constraint.
    -->
    <InvariantGlobalization>false</InvariantGlobalization>

    <IsTestProject Condition="!$([MSBuild]::IsOSPlatform('Windows'))">false</IsTestProject>
    <EnableDefaultCompileItems Condition="!$([MSBuild]::IsOSPlatform('Windows'))">false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <ProjectReference Include="..\..\src\Einzel.Wpf\Einzel.Wpf.csproj" />
    <ProjectReference Include="..\..\src\Einzel.Cli\Einzel.Cli.csproj" />
  </ItemGroup>

</Project>
