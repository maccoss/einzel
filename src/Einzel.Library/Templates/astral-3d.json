{
  "schemaVersion": "0.8",
  "name": "astral-3d",
  "description": "The Thermo Astral analyser: an asymmetric-track multi-reflection time-of-flight instrument, modelled entirely from published information. Two elongated mirrors face each other across a 40 mm board gap; ions oscillate between them while drifting along their length, and the mirrors converge slightly so the drift decelerates and reverses. Each mirror is a two-dimensional cross-section whose extrusion axis is tilted by half the convergence, which makes the field anisotropy Ez/Ex exactly tan(alpha) instead of a quantity no affordable three-dimensional mesh can resolve - see docs/astral-handoff.md sections 12 and 13. The two solves carry one mirror at potential with the other grounded, which is the ordinary basis decomposition and therefore exact. The ion foil is not included: its shape is measured in section 11 and the drift force it produced was 5.7 times what the published reversal needs, so it is a study rather than part of the shipped device.",
  "parameters": {
    "ionEnergy": {
      "value": 4000.0,
      "unit": "V",
      "minimum": 100.0,
      "maximum": 20000.0,
      "description": "Nominal beam energy. Stewart et al.: 4 keV entering the analyser."
    },
    "convergence": {
      "value": 0.2,
      "unit": "mm",
      "minimum": 0.0,
      "maximum": 40.0,
      "description": "Cap-to-cap gap narrowing over the drift length, so the mirrors converge toward +z, the direction the ion drifts. Each mirror cross-section is extruded along an axis tilted by half of that: the near stack by +mirrorTilt and the far by -mirrorTilt. Published value 0.200 mm, from a 200 micron spacer."
    },
    "injectionAngle": {
      "value": 0.03492076949174773,
      "unit": "1",
      "minimum": 0.0005,
      "maximum": 0.2,
      "description": "Tangent of the angle between the ion trajectory and the mirror axis, which sets the drift rate as V tan(theta). Stewart et al. give the working inclination as about two degrees, adjusted by the second electrostatic prism after the first reflection."
    },
    "driftLength": {
      "value": 350.0,
      "unit": "mm",
      "minimum": 50.0,
      "maximum": 800.0,
      "description": "Extent along the drift. Published 310-360 mm."
    },
    "capToCap": {
      "value": 625.0,
      "unit": "mm",
      "minimum": 50.0,
      "maximum": 3000.0,
      "description": "Derived from published figures: 30 m over 24 oscillations, out and back."
    },
    "boardGap": {
      "value": 40.0,
      "unit": "mm",
      "minimum": 5.0,
      "maximum": 120.0,
      "description": "Board-to-board separation at the drift mid-point."
    },
    "boardThickness": {
      "value": 4.0,
      "unit": "mm",
      "minimum": 0.5,
      "maximum": 20.0,
      "description": "How thick each board is in y."
    },
    "vacuumPad": {
      "value": 6.0,
      "unit": "mm",
      "minimum": 0.0,
      "maximum": 60.0,
      "description": "Vacuum between the outermost metal and the solve boundary."
    },
    "detectorInset": {
      "value": 10.0,
      "unit": "mm",
      "minimum": 1.0,
      "maximum": 100.0,
      "description": "How far inside the far end the collecting plane sits."
    },
    "d1": {
      "value": 20.0,
      "unit": "mm",
      "minimum": 2.0,
      "maximum": 350.0,
      "description": "Depth at which U1 is reached, from the mirror mouth. FREE: no paper states the electrode lengths, and they are what the published coefficients were optimised against."
    },
    "d2": {
      "value": 50.0,
      "unit": "mm",
      "minimum": 2.0,
      "maximum": 350.0,
      "description": "Depth at which U2 is reached, from the mirror mouth. FREE: no paper states the electrode lengths, and they are what the published coefficients were optimised against."
    },
    "d3": {
      "value": 90.0,
      "unit": "mm",
      "minimum": 2.0,
      "maximum": 350.0,
      "description": "Depth at which U3 is reached, from the mirror mouth. FREE: no paper states the electrode lengths, and they are what the published coefficients were optimised against."
    },
    "d4": {
      "value": 130.0,
      "unit": "mm",
      "minimum": 2.0,
      "maximum": 350.0,
      "description": "Depth at which U4 is reached, from the mirror mouth. FREE: no paper states the electrode lengths, and they are what the published coefficients were optimised against."
    },
    "halfGap": {
      "expression": "boardGap / 2",
      "unit": "mm",
      "description": ""
    },
    "mouth": {
      "expression": "d4",
      "unit": "mm",
      "description": "Where each mirror opens toward the beam."
    },
    "boardOuter": {
      "expression": "halfGap + boardThickness",
      "unit": "mm",
      "description": ""
    },
    "domainY": {
      "expression": "halfGap + boardThickness + vacuumPad",
      "unit": "mm",
      "description": ""
    },
    "domainMaxX": {
      "expression": "capToCap + vacuumPad",
      "unit": "mm",
      "description": ""
    },
    "domainMinX": {
      "expression": "-vacuumPad",
      "unit": "mm",
      "description": ""
    },
    "midPlane": {
      "expression": "capToCap / 2",
      "unit": "mm",
      "description": ""
    },
    "detectorZ": {
      "expression": "driftLength - detectorInset",
      "unit": "mm",
      "description": "kept for reference: where a detector at the FAR end of the drift would sit. The shipped detector is behind the launch point instead, because an asymmetric-track analyser's ions drift out, reverse, and come back - catching them at the far end measures only the outbound half and hides the behaviour the device is named for."
    },
    "mirrorTilt": {
      "expression": "asinPi(convergence / 2 / driftLength)",
      "unit": "1",
      "description": "half the angle between the two mirror assemblies. Tilting the MIRRORS (about y) is what reverses the drift: each reflection turns the velocity by twice this, so the drift decelerates by 2*v_x*theta per reflection whatever the mirror depth. Tilting the BOARDS (about x) instead closes the gap the ion flies down, which also decelerates the drift but about three times more weakly - see docs/astral-handoff.md."
    },
    "zPad": {
      "value": 150.0,
      "unit": "mm",
      "minimum": 0.0,
      "maximum": 400.0,
      "description": "how far the solve domain and the electrode stripes run beyond the drift at each end. The reversal convergence moves 7.4% from 0 to 50 mm and 0.4% from 50 to 150, so this is converged; at zero the Neumann face sits 10 mm from where the ion turns round."
    },
    "foilVolts": {
      "value": 0.0,
      "unit": "V",
      "minimum": -20.0,
      "maximum": 0.0,
      "description": "the ion foil bias. Published as tunable between 0 and -20 V. SHIPS AT ZERO, so the foil is present in the geometry and does nothing until it is fitted - a default that makes a device worse is worse than no default, and nothing yet establishes the value."
    },
    "foilThickness": {
      "value": 2.0,
      "unit": "mm",
      "minimum": 0.5,
      "maximum": 6.0,
      "description": "how thick the foil electrodes are."
    },
    "foilGap": {
      "value": 20.0,
      "unit": "mm",
      "minimum": 2.0,
      "maximum": 30.0,
      "description": "Half-gap between the foil plates in the board-gap direction. Defaults to halfGap, so the foil is a shaped conductive region on the inner face of each board rather than a separate aperture in the flight path - which is both the plausible construction for a printed-circuit analyser and what the published schematic projects to. Mounting the plates flush costs 15% of the well depth (7.31 V against 8.58 V at foilGap 8 mm) and leaves the well shape unchanged, shallowest at 41% of the drift and deepest at 67%."
    },
    "foilSlices": {
      "value": 16.0,
      "unit": "1",
      "minimum": 4.0,
      "maximum": 64.0,
      "description": "Number of constant-width boxes the contoured foil plate is built from. The contour runs along the drift, so each slice spans a range of drift and holds one inner-edge position."
    },
    "foilOuterFrac": {
      "value": 0.8,
      "unit": "1",
      "minimum": 0.1,
      "maximum": 0.98,
      "description": "Foil plate outer edge, as a fraction of the mid-plane to mirror-mouth distance. Measured from the published schematic at 146 mm of 182 mm; the outer edge is straight to within one pixel over the whole drift."
    },
    "foilInnerMid": {
      "value": 0.578,
      "unit": "1",
      "minimum": 0.1,
      "maximum": 0.95,
      "description": "Mean position of the foil plate inner edge, as a fraction of the mid-plane to mirror-mouth distance. The inner edge is contoured along the drift; this is the midpoint of that contour."
    },
    "foilInnerAmplitude": {
      "value": 0.063,
      "unit": "1",
      "minimum": 0.0,
      "maximum": 0.4,
      "description": "Half the peak-to-peak excursion of the foil inner edge along the drift. The published schematic gives 0.641 of the reach at the plate thinnest and 0.515 at its thickest."
    },
    "foilThinAt": {
      "value": 0.41,
      "unit": "1",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Drift fraction at which the foil plate is thinnest, so its inner edge lies furthest from the axis and the gap between the two plates is widest."
    },
    "foilThickAt": {
      "value": 0.67,
      "unit": "1",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Drift fraction at which the foil plate is thickest, so its inner edge lies closest to the axis and the gap between the two plates is narrowest. Half a contour wavelength past foilThinAt."
    },
    "foilStartFrac": {
      "value": 0.25,
      "unit": "1",
      "minimum": 0.0,
      "maximum": 0.9,
      "description": "Drift fraction at which the foil begins. The published schematic shows the plates starting about a quarter of the way along, downstream of the injection optics."
    },
    "foilReach": {
      "expression": "midPlane - mouth",
      "unit": "mm",
      "description": "Distance from the analyser mid-plane to a mirror mouth, the scale the foil plate positions are expressed as fractions of."
    },
    "foilOuter": {
      "expression": "foilOuterFrac * foilReach",
      "unit": "mm",
      "description": "Foil plate outer edge, measured from the mid-plane."
    },
    "foilDriftSpan": {
      "expression": "1 - foilStartFrac",
      "unit": "1",
      "description": "Fraction of the drift the foil covers."
    }
  },
  "ion": {
    "massToCharge": {
      "value": 500,
      "unit": "Da"
    },
    "chargeNumber": 1
  },
