{
  "schemaVersion": "0.7",
  "name": "astral-3d",
  "description": "The Thermo Astral analyser as a solved volume: five-electrode mirrors at the published potentials, TILTED ABOUT y so the two mirrors converge along the drift. THE CONVERGENCE IS THE MECHANISM rather than a tolerance - it breaks translational invariance, which is what makes the drift decelerate and reverse, and a multi-reflection analyser whose mirrors are parallel cannot do that however it is tuned. WHICH AXIS MATTERS: tilting the mirrors (about y) gives each reflection a z-impulse of theta times its fixed x-impulse; tilting the boards (about x, as this template did until measured) instead closes the gap the ion flies down, which decelerates the drift about three times more weakly and needed a 1.58 mm spacer where the mirrors need 0.27. MEASURED: the drift reverses at convergence 0.267 mm (bracketed 0.26 to 0.28) at the design condition, against a published 200 um - a tested prediction, bracketed by runs that took no part in the fit. The oscillation count is N = injectionAngle * driftLength / (eta * convergence), where eta is the fraction of the ideal specular impulse this mirror delivers - 0.578 measured here, not 1, so the period does not quite cancel. The form is exact (checked by the 1/c scaling and by the sharper alpha/c invariance, 0.5%); the coefficient belongs to the mirror, and is the figure of merit the electrode depths actually move. GUESSED: the electrode depths d1..d4, because no paper states them; the scan that appeared to constrain them was measuring ions striking metal, and a tilted mirror's impulse is independent of its depth, so they need a figure of merit that moves with them. KNOWN WRONG: the drift faces are declared neumann, which says the structure repeats along z - true while the boards are parallel, false the moment they converge. That is now bounded rather than feared: it is worth about 11 per cent and is converged at the zPad declared here, and grounding those faces instead pins the ion in z entirely. See docs/astral-handoff.md.",
  "parameters": {
    "ionEnergy": {
      "value": 4000.0,
      "unit": "V",
      "minimum": 100.0,
      "maximum": 20000.0,
      "description": "Nominal beam energy. Stewart et al.: 4 keV entering the analyser."
    },
    "convergence": {
      "value": 0.2,
      "unit": "mm",
      "minimum": 0.0,
      "maximum": 40.0,
      "description": "how much closer the two mirrors are at the far end of the drift than the near end - the spacer that sets the mirror tilt. 200 um is the published figure; this model reverses the drift at 0.267 mm at the design condition, so it arrives here and turns round just above."
    },
    "injectionAngle": {
      "value": 0.022343931724278912,
      "unit": "1",
      "minimum": 0.0005,
      "maximum": 0.2,
      "description": "tangent of the injection angle to the mirror axis. 1.28 degrees is the design condition: oscillations = 2*drift/(2*capToCap*angle), and 24 of them out-and-back over a 335 mm drift needs this. A published prism angle of about 2 degrees would give 4, which is not a 30 m path."
    },
    "driftLength": {
      "value": 350.0,
      "unit": "mm",
      "minimum": 50.0,
      "maximum": 800.0,
      "description": "Extent along the drift. Published 310-360 mm."
    },
    "capToCap": {
      "value": 625.0,
      "unit": "mm",
      "minimum": 50.0,
      "maximum": 3000.0,
      "description": "Derived from published figures: 30 m over 24 oscillations, out and back."
    },
    "boardGap": {
      "value": 40.0,
      "unit": "mm",
      "minimum": 5.0,
      "maximum": 120.0,
      "description": "Board-to-board separation at the drift mid-point."
    },
    "boardThickness": {
      "value": 4.0,
      "unit": "mm",
      "minimum": 0.5,
      "maximum": 20.0,
      "description": "How thick each board is in y."
    },
    "vacuumPad": {
      "value": 6.0,
      "unit": "mm",
      "minimum": 0.0,
      "maximum": 60.0,
      "description": "Vacuum between the outermost metal and the solve boundary."
    },
    "detectorInset": {
      "value": 10.0,
      "unit": "mm",
      "minimum": 1.0,
      "maximum": 100.0,
      "description": "How far inside the far end the collecting plane sits."
    },
    "d1": {
      "value": 20.0,
      "unit": "mm",
      "minimum": 2.0,
      "maximum": 350.0,
      "description": "Depth at which U1 is reached, from the mirror mouth. FREE: no paper states the electrode lengths, and they are what the published coefficients were optimised against."
    },
    "d2": {
      "value": 50.0,
      "unit": "mm",
      "minimum": 2.0,
      "maximum": 350.0,
      "description": "Depth at which U2 is reached, from the mirror mouth. FREE: no paper states the electrode lengths, and they are what the published coefficients were optimised against."
    },
    "d3": {
      "value": 90.0,
      "unit": "mm",
      "minimum": 2.0,
      "maximum": 350.0,
      "description": "Depth at which U3 is reached, from the mirror mouth. FREE: no paper states the electrode lengths, and they are what the published coefficients were optimised against."
    },
    "d4": {
      "value": 130.0,
      "unit": "mm",
      "minimum": 2.0,
      "maximum": 350.0,
      "description": "Depth at which U4 is reached, from the mirror mouth. FREE: no paper states the electrode lengths, and they are what the published coefficients were optimised against."
    },
    "halfGap": {
      "expression": "boardGap / 2",
      "unit": "mm",
      "description": ""
    },
    "mouth": {
      "expression": "d4",
      "unit": "mm",
      "description": "Where each mirror opens toward the beam."
    },
    "boardOuter": {
      "expression": "halfGap + boardThickness",
      "unit": "mm",
      "description": ""
    },
    "domainY": {
      "expression": "halfGap + boardThickness + vacuumPad",
      "unit": "mm",
      "description": ""
    },
    "domainMaxX": {
      "expression": "capToCap + vacuumPad",
      "unit": "mm",
      "description": ""
    },
    "domainMinX": {
      "expression": "-vacuumPad",
      "unit": "mm",
      "description": ""
    },
    "midPlane": {
      "expression": "capToCap / 2",
      "unit": "mm",
      "description": ""
    },
    "detectorZ": {
      "expression": "driftLength - detectorInset",
      "unit": "mm",
      "description": ""
    },
    "mirrorTilt": {
      "expression": "asinPi(convergence / 2 / driftLength)",
      "unit": "1",
      "description": "half the angle between the two mirror assemblies. Tilting the MIRRORS (about y) is what reverses the drift: each reflection turns the velocity by twice this, so the drift decelerates by 2*v_x*theta per reflection whatever the mirror depth. Tilting the BOARDS (about x) instead closes the gap the ion flies down, which also decelerates the drift but about three times more weakly - see docs/astral-handoff.md."
    },
    "zPad": {
      "value": 150.0,
      "unit": "mm",
      "minimum": 0.0,
      "maximum": 400.0,
      "description": "how far the solve domain and the electrode stripes run beyond the drift at each end. The reversal convergence moves 7.4% from 0 to 50 mm and 0.4% from 50 to 150, so this is converged; at zero the Neumann face sits 10 mm from where the ion turns round."
    }
  },
