                },
                "index": "k",
                "x": {
                  "expression": "bendRadius - (inscribedRadius * sqrt(1 + ((-slotHalfWidth + (-rodHalfWidth - (-slotHalfWidth)) * k / 24) / inscribedRadius) * ((-slotHalfWidth + (-rodHalfWidth - (-slotHalfWidth)) * k / 24) / inscribedRadius)))",
                  "unit": "mm"
                },
                "y": {
                  "expression": "(-slotHalfWidth + (-rodHalfWidth - (-slotHalfWidth)) * k / 24)",
                  "unit": "mm"
                }
