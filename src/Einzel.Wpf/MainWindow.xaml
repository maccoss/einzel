<Window x:Class="Einzel.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hx="clr-namespace:HelixToolkit.Wpf.SharpDX;assembly=HelixToolkit.Wpf.SharpDX"
        Title="Einzel" Height="860" Width="1480"
        UseLayoutRounding="True">
  <Window.Resources>
    <Style TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Consolas" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="FontFamily" Value="Consolas" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="Margin" Value="0,0,4,0" />
      <Setter Property="MinWidth" Value="46" />
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="FontFamily" Value="Consolas" />
      <Setter Property="Margin" Value="10,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Window.Resources>

  <DockPanel>
    <!--
      Validation is never behind a disclosure control. Section 16 says results carry
      uncertainty and warnings alongside the value and never behind one, and the same
      reasoning applies to whether the document is valid at all: a person who has to
      open a panel to find out is a person who will not.
    -->
    <Border DockPanel.Dock="Bottom" Padding="8,6" x:Name="StatusBar">
      <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
    </Border>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.5*" />
        <ColumnDefinition Width="5" />
        <ColumnDefinition Width="2.4*" />
        <ColumnDefinition Width="5" />
        <ColumnDefinition Width="1*" />
      </Grid.ColumnDefinitions>

      <DockPanel Grid.Column="0">
        <TextBlock DockPanel.Dock="Top" Text="Parameters" Margin="8,8,8,4" FontWeight="Bold" />

        <DataGrid x:Name="ParameterGrid" AutoGenerateColumns="False" Margin="8,0,8,8"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  CellEditEnding="OnCellEditEnding">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Parameter" Binding="{Binding Name}" IsReadOnly="True" Width="1.4*" />
            <!--
              One-way on purpose. The column is editable and `Shown` has no setter,
              so a two-way binding would try to write the edited text back to a
              read-only property and fail. The commit is handled in
              OnCellEditEnding, which reads the TextBox and puts the value through
              the journal - so the binding only ever needs to carry the value out.
            -->
            <DataGridTextColumn Header="Value" Width="1.6*"
                                Binding="{Binding Shown, Mode=OneWay}" />
            <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" IsReadOnly="True" Width="0.6*" />
            <DataGridTextColumn Header="Bounds" Binding="{Binding Bounds}" IsReadOnly="True" Width="1.2*" />
            <DataGridTextColumn Header="Resolved" Binding="{Binding Resolved}" IsReadOnly="True" Width="1*" />
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>

      <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" />

      <!--
        The 3D viewport (section 16). DirectX 11 through Helix, because plain WPF
        Media3D cannot draw 10^4 trajectories interactively - and because section 17
        is emphatic that this path is screen tuning rather than an artifact. The
        publication figure comes from Einzel.Render, which is vector, headless, and
        owes nothing to this dependency.
      -->
      <DockPanel Grid.Column="2">
        <TextBlock DockPanel.Dock="Top" Text="Viewport" Margin="8,8,8,4" FontWeight="Bold" />

        <!--
          The view controls, and they exist because the gestures are not discoverable.
          Rotate, pan and zoom have always worked; nothing said so. Named views matter
          more than the gestures for an instrument - the axial section and the two
          transverse ones are how ion optics is read, and getting to one by dragging is
          approximate where a button is exact.
        -->
        <ToolBarTray DockPanel.Dock="Top" IsLocked="True" Background="Transparent">
          <ToolBar Background="Transparent" Band="0">
            <TextBlock Text="View" VerticalAlignment="Center" Margin="4,0,8,0" Foreground="#606A72" />
            <Button x:Name="ViewSide"  Content="Side"  Click="OnView" Tag="side"
                    ToolTip="Look along -z: the axial section, x across and y up" />
            <Button x:Name="ViewTop"   Content="Top"   Click="OnView" Tag="top"
                    ToolTip="Look down -y: x across and z up" />
            <Button x:Name="ViewFront" Content="Front" Click="OnView" Tag="front"
                    ToolTip="Look along -x, down the axis: the transverse section" />
            <Button x:Name="ViewIso"   Content="Iso"   Click="OnView" Tag="iso"
                    ToolTip="An oblique view" />
            <Separator />
            <Button x:Name="ViewFit"   Content="Fit"   Click="OnView" Tag="fit"
                    ToolTip="Frame everything drawn" />
            <Separator />
            <CheckBox x:Name="ShowElectrodes" Content="electrodes" IsChecked="True"
                      Click="OnLayer" ToolTip="The conductors, coloured by what they hold" />
            <CheckBox x:Name="ShowField" Content="field" IsChecked="True"
                      Click="OnLayer" ToolTip="Equipotentials on the z = 0 plane" />
            <CheckBox x:Name="ShowPaths" Content="paths" IsChecked="True"
                      Click="OnLayer" ToolTip="Trajectories, coloured by energy" />
            <CheckBox x:Name="Transparent" Content="see through" IsChecked="True"
                      Click="OnLayer"
                      ToolTip="Draw electrodes semi-transparent, so paths inside stay visible" />
          </ToolBar>
        </ToolBarTray>

        <!--
          RND-8 on the face of the viewport. A diffusive model has no trajectories, and
          an empty viewport looks exactly like one whose ions were all lost - so the
          reason is stated where the picture would be rather than left to be inferred.
        -->
        <Border DockPanel.Dock="Bottom" x:Name="ViewportNote" Margin="8,0,8,8" Padding="6,4"
                Background="#FFF4E5" Visibility="Collapsed">
          <TextBlock x:Name="ViewportNoteText" TextWrapping="Wrap" FontSize="11" />
        </Border>

        <!-- The scales the colours mean. A picture coloured by a quantity needs them. -->
        <Grid DockPanel.Dock="Bottom" Margin="8,4,8,4">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <TextBlock Grid.Row="0" Grid.Column="0" x:Name="EnergyLabel" Text="energy"
                     FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"
                     Foreground="#606A72" />
          <TextBlock Grid.Row="0" Grid.Column="1" x:Name="ScaleLow" FontSize="11"
                     VerticalAlignment="Center" Margin="0,0,6,0" />
          <Border Grid.Row="0" Grid.Column="2" Height="11" BorderThickness="1"
                  BorderBrush="#C9CFD4" x:Name="ScaleBar" Visibility="Collapsed">
            <Rectangle x:Name="ScaleSwatch" />
          </Border>
          <TextBlock Grid.Row="0" Grid.Column="3" x:Name="ScaleHigh" FontSize="11"
                     VerticalAlignment="Center" Margin="6,0,0,0" />

          <TextBlock Grid.Row="1" Grid.Column="0" Text="potential" FontSize="11"
                     VerticalAlignment="Center" Margin="0,4,8,0" Foreground="#606A72"
                     x:Name="PotentialLabel" />
          <TextBlock Grid.Row="1" Grid.Column="1" x:Name="VoltsLow" FontSize="11"
                     VerticalAlignment="Center" Margin="0,4,6,0" />
          <Border Grid.Row="1" Grid.Column="2" Height="11" BorderThickness="1"
                  BorderBrush="#C9CFD4" Margin="0,4,0,0" x:Name="VoltsBar"
                  Visibility="Collapsed">
            <Rectangle x:Name="VoltsSwatch" />
          </Border>
          <TextBlock Grid.Row="1" Grid.Column="3" x:Name="VoltsHigh" FontSize="11"
                     VerticalAlignment="Center" Margin="6,4,0,0" />
        </Grid>

        <Border Margin="8,0,8,0" BorderThickness="1" BorderBrush="#C9CFD4">
          <!--
            Dark, and darker than it was, which is the opposite of what the symptom
            suggested. Everything here is a thin line or a semi-transparent surface, and
            against #141A20 the dark end of every scale - the slowest ion, the most
            negative electrode - was the hardest thing in the picture to see.

            Lightening the ground does not fix that: a sequential ramp spans dark to light
            by construction, so it passes through every background luminance, and measured
            across grounds from #101010 to #D0D0D0 the worst contrast anywhere on viridis
            never rises above 1.25. What fixes it is lifting the ramps off the ground and
            then putting the ground as far below them as it will go. Worst contrast
            anywhere: 4.70 on the energy scale and 6.77 on the potential one, against 1.01
            and 2.49 before.
          -->
          <hx:Viewport3DX x:Name="Viewport"
                          BackgroundColor="#081019"
                          ShowCoordinateSystem="True"
                          ShowViewCube="True"
                          IsZoomEnabled="True"
                          IsPanEnabled="True"
                          IsRotationEnabled="True"
                          TextBrush="#B9C2C9" />
        </Border>
      </DockPanel>

      <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" />

      <DockPanel Grid.Column="4">
        <!--
          The journal, which is MCP-1's payoff: a person can see what an agent did to
          their model, by name, and undo it. The commands beneath are Amendment 25 -
          every action here readable as something that could have been typed.
        -->
        <TextBlock DockPanel.Dock="Top" Text="Journal" Margin="8,8,8,4" FontWeight="Bold" />
        <ListBox x:Name="JournalList" DockPanel.Dock="Top" Height="200" Margin="8,0,8,8" />

        <TextBlock DockPanel.Dock="Top" Text="As commands" Margin="8,4,8,4" FontWeight="Bold" />
        <ListBox x:Name="CommandList" Margin="8,0,8,8" />
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
