<Window x:Class="Einzel.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Einzel" Height="760" Width="1180"
        UseLayoutRounding="True">
  <Window.Resources>
    <Style TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Consolas" />
    </Style>
  </Window.Resources>

  <DockPanel>
    <!--
      Validation is never behind a disclosure control. Section 16 says results carry
      uncertainty and warnings alongside the value and never behind one, and the same
      reasoning applies to whether the document is valid at all: a person who has to
      open a panel to find out is a person who will not.
    -->
    <Border DockPanel.Dock="Bottom" Padding="8,6" x:Name="StatusBar">
      <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
    </Border>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*" />
        <ColumnDefinition Width="5" />
        <ColumnDefinition Width="1*" />
      </Grid.ColumnDefinitions>

      <DockPanel Grid.Column="0">
        <TextBlock DockPanel.Dock="Top" Text="Parameters" Margin="8,8,8,4" FontWeight="Bold" />

        <DataGrid x:Name="ParameterGrid" AutoGenerateColumns="False" Margin="8,0,8,8"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  CellEditEnding="OnCellEditEnding">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Parameter" Binding="{Binding Name}" IsReadOnly="True" Width="1.4*" />
            <!--
              One-way on purpose. The column is editable and `Shown` has no setter,
              so a two-way binding would try to write the edited text back to a
              read-only property and fail. The commit is handled in
              OnCellEditEnding, which reads the TextBox and puts the value through
              the journal - so the binding only ever needs to carry the value out.
            -->
            <DataGridTextColumn Header="Value" Width="1.6*"
                                Binding="{Binding Shown, Mode=OneWay}" />
            <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" IsReadOnly="True" Width="0.6*" />
            <DataGridTextColumn Header="Bounds" Binding="{Binding Bounds}" IsReadOnly="True" Width="1.2*" />
            <DataGridTextColumn Header="Resolved" Binding="{Binding Resolved}" IsReadOnly="True" Width="1*" />
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>

      <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" />

      <DockPanel Grid.Column="2">
        <!--
          The journal, which is MCP-1's payoff: a person can see what an agent did to
          their model, by name, and undo it. The commands beneath are Amendment 25 -
          every action here readable as something that could have been typed.
        -->
        <TextBlock DockPanel.Dock="Top" Text="Journal" Margin="8,8,8,4" FontWeight="Bold" />
        <ListBox x:Name="JournalList" DockPanel.Dock="Top" Height="220" Margin="8,0,8,8" />

        <TextBlock DockPanel.Dock="Top" Text="As commands" Margin="8,4,8,4" FontWeight="Bold" />
        <ListBox x:Name="CommandList" Margin="8,0,8,8" />
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
