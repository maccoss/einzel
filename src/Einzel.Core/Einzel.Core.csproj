<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Einzel.Core</RootNamespace>
    <Description>
      Model, units, geometry, symmetry, parameters, and validation. The innermost
      assembly of the Einzel ion-optics platform; references nothing above it.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Einzel.Core.Tests" />
    <!-- Watching GridArrays allocate, which is how the memory tests read what a solve or a
         density run holds: the two test assemblies that measure, and the harness. No assembly
         that ships is given sight of this one's internals; allocating is public. -->
    <InternalsVisibleTo Include="Einzel.Fields.Tests" />
    <InternalsVisibleTo Include="Einzel.Cli.Tests" />
    <InternalsVisibleTo Include="memory-harness" />
  </ItemGroup>

</Project>
