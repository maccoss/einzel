<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Einzel.Core</RootNamespace>
    <Description>
      Model, units, geometry, symmetry, parameters, and validation. The innermost
      assembly of the Einzel ion-optics platform; references nothing above it.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Einzel.Core.Tests" />
    <!-- GridArrays, the one place a grid-sized array is allocated: the two assemblies that
         allocate them, and the test assemblies and the harness that watch them being allocated
         to read what a solve or a density run holds. Internal on purpose; see the type. -->
    <InternalsVisibleTo Include="Einzel.Fields" />
    <InternalsVisibleTo Include="Einzel.Transport" />
    <InternalsVisibleTo Include="Einzel.Fields.Tests" />
    <InternalsVisibleTo Include="Einzel.Cli.Tests" />
    <InternalsVisibleTo Include="memory-harness" />
  </ItemGroup>

</Project>
