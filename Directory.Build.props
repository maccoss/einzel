<Project>

  <PropertyGroup>
    <!-- Pre-release. Every run manifest records this, so it must not claim 1.0.0. -->
    <VersionPrefix>0.1.0</VersionPrefix>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!--
    Warnings are errors. A numerical engine held to ACC-1 (1 ppm) cannot afford a
    culture of ignored diagnostics; see spec section 8.
  -->
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
  </PropertyGroup>

  <!--
    AGT-7, the platform is self-describing at runtime. Public API carries XML
    documentation, and missing documentation is a build failure rather than a
    lint suggestion, because the schema descriptions and CLI help are generated
    from the same metadata.
  -->
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    Determinism. Spec section 8 does not require bit-reproducibility across
    machines, but it does require run-to-run reproducibility on one machine, and
    a deterministic build is the floor for that. InvariantGlobalization keeps
    number and date formatting from varying with the host locale, which would
    otherwise leak into CLI output (CLI-5, deterministic output ordering) and
    into golden-file comparisons.
  -->
  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

</Project>
